---
import CreditedPhoto from '../components/CreditedPhoto.astro';
import Page from '../layouts/Page.astro';
import DownsizingPromo from '../components/DownsizingPromo.astro';
import market from '../data/market.json';
import { cad, neighbourhoodPath } from '../lib/format';
import { CITIES, TORONTO } from '../lib/comparisons';
import monthly from '../data/trreb-monthly.json';

/**
 * Toronto house prices, from TRREB. City figures live in src/data/trreb-monthly.json, refreshed from
 * each new Market Watch by the update routine. Community medians come from src/data/market.json,
 * refreshed from the quarterly Toronto Central, East and West community reports.
 */
const PERIOD = monthly.period;
const REPORT = monthly.report || '/market-reports/';
const BY_TYPE = monthly.torontoByType;
const DETACHED = BY_TYPE.find((r) => r.type === 'Detached')!;
const CONDO = BY_TYPE.find((r) => r.type === 'Condo apartment')!;
const CONDO_SHARE = Math.round((CONDO.sales / TORONTO.sales) * 100);
const RATIO = (DETACHED.median / CONDO.median).toFixed(1);
const priced = market.neighbourhoods.filter((n): n is typeof n & { price: number } => typeof n.price === 'number');
const top = [...priced].sort((a, b) => b.price - a.price)[0];
const bottom = [...priced].sort((a, b) => a.price - b.price)[0];

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Toronto House Prices', path: '/toronto-house-prices/' },
];

const faq = [
  {
    q: 'What is the average home price in Toronto?',
    a: `For the City of Toronto, TRREB recorded an average of ${cad(TORONTO.average)} across all property types in ${PERIOD}, from ${TORONTO.sales.toLocaleString('en-CA')} sales. Detached houses averaged ${cad(DETACHED.average)} and condo apartments ${cad(CONDO.average)}.`,
  },
  {
    q: 'What is the median home price in Toronto?',
    a: `${cad(TORONTO.median)} across all property types in ${PERIOD} (TRREB, City of Toronto). By type, the detached median was ${cad(DETACHED.median)} and the condo apartment median ${cad(CONDO.median)}.`,
  },
  {
    q: 'Why is the Toronto median so much lower than the detached price?',
    a: `Because most sales in the city are condo apartments. In ${PERIOD}, ${CONDO.sales.toLocaleString('en-CA')} of the ${TORONTO.sales.toLocaleString('en-CA')} sales TRREB recorded in the City of Toronto, about ${CONDO_SHARE}%, were condo apartments, which pulls the all types median well below the price of a house.`,
  },
  {
    q: 'Which of the communities on this page had the highest median?',
    a: `For ${market.period}, ${top.name} had the highest all property types median of the communities covered here, at ${cad(top.price)}. ${bottom.name} had the lowest, at ${cad(bottom.price)} (TRREB). The gap mostly reflects the mix of houses and condos that sold, so compare one property type at a time.`,
  },
  {
    q: 'Can these figures tell me what my home is worth?',
    a: 'No. They describe a whole city or community for one period. What one home is worth depends on its size, condition, lot and the sales on nearby streets, which is what a free valuation looks at.',
  },
];

const sources = [
  { name: `TRREB Market Watch, ${PERIOD}`, url: monthly.sourceUrl },
  { name: `TRREB Community Housing Market Report, Toronto Central, ${market.period}`, url: market.reports.central },
  { name: `TRREB Community Housing Market Report, Toronto East, ${market.period}`, url: market.reports.east },
  { name: `TRREB Community Housing Market Report, Toronto West, ${market.period}`, url: market.reports.west },
];
---

<Page
  title="Toronto House Prices 2026: Latest TRREB Figures"
  description={`Average and median Toronto house prices from TRREB for ${PERIOD}, by property type, for 18 communities and against other GTA cities.`}
  eyebrow="Toronto, Ontario"
  h1="Toronto house prices"
  lede={`TRREB's latest City of Toronto figures: a ${cad(TORONTO.median)} median and a ${cad(TORONTO.average)} average across ${TORONTO.sales.toLocaleString('en-CA')} sales in ${PERIOD}, broken down by property type and by community.`}
  crumbs={crumbs}
  faq={faq}
>
  <section class="section">
    <div class="wrap-narrow prose">
      <CreditedPhoto slug="downtown-waterfront" priority />
      <h2>Toronto prices by property type, {PERIOD}</h2>
      <table>
        <thead><tr><th>Property type</th><th>Sales</th><th>Average</th><th>Median</th></tr></thead>
        <tbody>
          {BY_TYPE.map((r) => <tr><td>{r.type}</td><td>{r.sales.toLocaleString('en-CA')}</td><td>{cad(r.average)}</td><td>{cad(r.median)}</td></tr>)}
          <tr><td><strong>All property types</strong></td><td>{TORONTO.sales.toLocaleString('en-CA')}</td><td>{cad(TORONTO.average)}</td><td>{cad(TORONTO.median)}</td></tr>
        </tbody>
      </table>
      <p>
        Read the row that matches the home you own or want. About {CONDO_SHARE}% of the month's sales
        in the City of Toronto were condo apartments, so the all types median describes condos far more
        than houses. In {PERIOD} the detached median was {RATIO} times the condo apartment median. The
        <a href={REPORT}>{PERIOD} Toronto market report</a> covers the whole month, including new
        listings and days on market.
      </p>

      <h2>Prices in the communities we cover</h2>
      <p>
        TRREB publishes quarterly figures for each of its Toronto communities. These are the all property
        types medians for {market.period} in the communities behind our eighteen neighbourhood guides. Where
        a guide spans two TRREB communities, both are listed under TRREB's own names.
      </p>
      <table>
        <thead><tr><th>TRREB community</th><th>Median, all property types</th></tr></thead>
        <tbody>
          {market.neighbourhoods.map((n) => <tr><td><a href={neighbourhoodPath(n.slug)}>{n.name}</a></td><td>{typeof n.price === 'number' ? cad(n.price) : 'Not reported'}</td></tr>)}
        </tbody>
      </table>
      <p>
        A low median is often a sign that condo apartments dominated the sales rather than a sign of cheap
        houses. Each <a href="/neighbourhoods/">neighbourhood guide</a> splits its community figures by
        property type.
      </p>

      <h2>Toronto next to Markham, Mississauga and Vaughan</h2>
      <table>
        <thead><tr><th>City, {PERIOD}</th><th>Sales</th><th>Median</th><th>Average</th></tr></thead>
        <tbody>
          <tr><td>City of Toronto</td><td>{TORONTO.sales.toLocaleString('en-CA')}</td><td>{cad(TORONTO.median)}</td><td>{cad(TORONTO.average)}</td></tr>
          {
            CITIES.map((c) => (
              <tr>
                <td><a href={`/toronto-vs-${c.slug}/`}>{c.name}</a></td>
                <td>{c.stats.sales.toLocaleString('en-CA')}</td>
                <td>{cad(c.stats.median)}</td>
                <td>{cad(c.stats.average)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p>
        Toronto's lower headline median against its neighbours comes from the same condo effect. Each
        comparison page sets detached against detached and condo against condo.
      </p>

      <h2>Median and average are different questions</h2>
      <p>
        The median is the sale in the middle of the list, with half above it and half below. The average
        adds every price and divides by the number of sales, so a small number of very expensive homes
        lifts it. In Toronto, where a few sales each month run into many millions, the average usually
        sits well above the median. For planning, the median for one property type is the steadier guide.
        Neither figure values a particular home.
      </p>

      <h2>Using these numbers</h2>
      <ul>
        <li>Selling: a <a href="/home-valuation/">free home valuation</a> starts from the comparable sales around your street. With a free account you can also <a href="/sold/">look up Toronto sold prices</a> yourself.</li>
        <li>Downsizing: compare <a href="/best-toronto-neighbourhoods-for-downsizing/">Toronto neighbourhoods for downsizing</a> by what the smaller homes there cost.</li>
        <li>Buying: put the price you have in mind through the <a href="/mortgage-calculator-toronto/">mortgage calculator</a> and the <a href="/land-transfer-tax-calculator-toronto/">land transfer tax calculator</a>, which adds Toronto's municipal tax.</li>
      </ul>
    </div>

    <div class="wrap-narrow" style="margin-top: var(--sp-6)">
      <DownsizingPromo />
    </div>

    <div class="wrap-narrow prose">
      <h2>Sources</h2>
      <ul>
        {sources.map((s) => <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.name}</a></li>)}
      </ul>
      <p>General information from TRREB for the periods stated. It is not an appraisal or an opinion of the value of any property.</p>
    </div>
  </section>
</Page>
