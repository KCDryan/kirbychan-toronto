---
/**
 * Blog upload. Paste the HTML of an article (for example from onecutcontent.com), check the
 * details and the preview, then press Publish: the post is live straight away in the site's own
 * style. Or save it as a draft and finish it later. One shared password, set as UPLOAD_PASSWORD in
 * Cloudflare. The API is functions/api/upload/[action].ts.
 */
import Base from '../../layouts/Base.astro';
import { BLOG_CATEGORIES } from '../../lib/blog';
import { HOODS, ROLES, SERVICES } from '../../lib/post-links';
---

<Base title="Upload a blog post" description="Upload a blog post to the Kirby Chan & Co. Toronto website." noindex>
  <div class="up wrap">
    <h1>Upload a blog post</h1>
    <p class="up__status" id="up-status" role="status" aria-live="polite">Loading…</p>

    <section id="up-setup" class="up__box" hidden>
      <p>Uploads are not switched on yet. The website owner needs to set the upload password in Cloudflare.</p>
    </section>

    <form id="up-login" class="up__box" hidden>
      <label for="up-password">Password</label>
      <input id="up-password" type="password" autocomplete="current-password" required />
      <button class="btn btn--primary" type="submit">Sign in</button>
    </form>

    <div id="up-main" hidden>
      <section class="up__box">
        <h2><span class="up__num">1</span> Paste the article</h2>
        <p>Copy the HTML of the finished article.</p>
        <textarea id="up-html" rows="8" spellcheck="false" placeholder="Paste here"></textarea>
        <p class="up__or">
          Or <label class="up__file">choose the saved HTML file<input id="up-file" type="file" accept=".html,.htm,.txt,text/html" /></label>
        </p>
      </section>

      <section class="up__box" id="up-check" hidden>
        <h2><span class="up__num">2</span> Check the details</h2>
        <p class="up__hint">These are filled in for you. Change anything that is not right.</p>
        <form id="up-details" class="up__fields">
          <label for="up-title">Title</label>
          <input id="up-title" maxlength="90" />
          <label for="up-category">Topic</label>
          <select id="up-category">
            {Object.entries(BLOG_CATEGORIES).map(([k, v]) => <option value={k}>{v}</option>)}
          </select>
          <div class="up__pair">
            <div>
              <label for="up-author">Written by</label>
              <input id="up-author" list="up-authors" maxlength="80" placeholder="Leave empty for the team" />
              <datalist id="up-authors"><option value="Kirby Chan"></option></datalist>
            </div>
            <div>
              <label for="up-role">Their title</label>
              <input id="up-role" list="up-roles" maxlength="80" placeholder="Choose or type" />
              <datalist id="up-roles">{ROLES.map((r) => <option value={r} />)}</datalist>
            </div>
          </div>
          <fieldset>
            <legend>Neighbourhoods this post is about</legend>
            <div class="up__ticks">
              {Object.entries(HOODS).map(([k, h]) => <label><input type="checkbox" name="related" value={k} /> {h.label}</label>)}
            </div>
          </fieldset>
          <fieldset>
            <legend>Service guides it relates to</legend>
            <div class="up__ticks">
              {Object.entries(SERVICES).map(([k, s]) => <label><input type="checkbox" name="relatedServices" value={k} /> {s.label}</label>)}
            </div>
          </fieldset>
        </form>
        <ul class="up__notes" id="up-notes"></ul>
        <p>This is exactly how the post will look on the website:</p>
        <iframe id="up-preview" title="Preview of the post" sandbox="allow-same-origin"></iframe>
      </section>

      <section class="up__box" id="up-go" hidden>
        <h2><span class="up__num">3</span> Publish</h2>
        <button class="btn btn--primary up__big" id="up-publish" type="button">Publish now</button>
        <button class="btn btn--ghost" id="up-draft" type="button">Save as a draft (not on the website yet)</button>
        <div id="up-done" class="up__done" hidden>
          <p id="up-done-text"></p>
          <button class="btn btn--ghost" id="up-again" type="button">Upload another post</button>
        </div>
      </section>

      <section class="up__box">
        <h2>Your uploaded posts</h2>
        <ul class="up__list" id="up-list"><li>None yet.</li></ul>
      </section>

      <p><button class="btn btn--ghost btn--sm" id="up-logout" type="button">Sign out</button></p>
    </div>
  </div>
</Base>

<script>
  import { convertHtml, guessCategory, slugFor, type Imported } from '../../lib/html-import';
  import { hoodsIn, servicesIn } from '../../lib/post-links';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const input = (id: string) => $<HTMLInputElement>(id);
  const status = $('up-status');
  const say = (text: string, bad = false) => {
    status.textContent = text;
    status.classList.toggle('up__status--bad', bad);
  };
  const api = async (action: string, body?: unknown) => {
    const res = await fetch(`/api/upload/${action}`, body === undefined ? {} : { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
    return { status: res.status, data: (await res.json().catch(() => ({}))) as Record<string, any> };
  };
  const show = (id: string, on: boolean) => ($(id).hidden = !on);
  const ticked = (name: string) => [...document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((c) => c.value);
  const tick = (name: string, ids: string[]) =>
    document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`).forEach((c) => (c.checked = ids.includes(c.value)));
  // The writer's name and title are remembered on this computer for the next post.
  const remember = (key: string, value?: string) => {
    try {
      if (value === undefined) return localStorage.getItem(key) ?? '';
      localStorage.setItem(key, value);
    } catch {}
    return '';
  };

  type Article = Pick<Imported, 'summary' | 'quickAnswer' | 'faq' | 'sources' | 'markdown'>;
  let article: Article | null = null;
  /** Set while changing a post that was saved before: it keeps its web address. */
  let editing = '';

  const post = (draft = false) => {
    const headline = input('up-title').value.trim();
    return {
      ...article,
      headline,
      slug: editing || slugFor(headline),
      category: $<HTMLSelectElement>('up-category').value,
      author: input('up-author').value.trim(),
      authorTitle: input('up-author').value.trim() ? input('up-role').value.trim() : '',
      related: ticked('related'),
      relatedServices: ticked('relatedServices'),
      draft,
    };
  };

  async function start() {
    const { data } = await api('me');
    show('up-setup', !data.ready);
    show('up-login', data.ready && !data.signedIn);
    show('up-main', !!data.signedIn);
    say(!data.ready ? '' : data.signedIn ? 'Signed in.' : 'Please sign in.');
    if (data.signedIn) list();
  }

  const button = (text: string, onclick: () => void) => {
    const b = Object.assign(document.createElement('button'), { type: 'button', className: 'btn btn--ghost btn--sm', textContent: text });
    b.onclick = onclick;
    return b;
  };

  async function list() {
    const { data } = await api('list');
    const ul = $('up-list');
    ul.replaceChildren();
    for (const p of data.posts ?? []) {
      const li = document.createElement('li');
      const name = p.live
        ? Object.assign(document.createElement('a'), { href: p.url, target: '_blank', rel: 'noopener', textContent: p.headline })
        : Object.assign(document.createElement('span'), { textContent: p.headline });
      const state = Object.assign(document.createElement('span'), { className: 'up__state', textContent: p.live ? 'Live' : p.draft ? 'Draft' : 'Taken down' });
      const actions = document.createElement('span');
      actions.className = 'up__actions';
      actions.append(button('Edit', () => open(p.slug)));
      if (p.live) {
        actions.append(
          button('Take down', async () => {
            if (!confirm(`Take "${p.headline}" off the website?`)) return;
            await api('unpublish', { slug: p.slug });
            say('The post has been taken down.');
            list();
          })
        );
      }
      li.append(name, state, actions);
      ul.append(li);
    }
    if (!ul.children.length) ul.innerHTML = '<li>None yet.</li>';
  }

  async function preview() {
    show('up-done', false);
    say('Making the preview…');
    const { status: code, data } = await api('preview', { post: post() });
    if (code === 401) return start();
    if (data.error) return say(data.error, true);
    $<HTMLIFrameElement>('up-preview').srcdoc = data.html;
    show('up-check', true);
    show('up-go', true);
    $('up-publish').textContent = data.exists ? 'Publish the changes' : 'Publish now';
    say('Preview ready. Check the details and read the post, then press Publish below.');
  }

  /** Fills every box from a post, then shows the preview. */
  function fill(p: Partial<ReturnType<typeof post>> & Article) {
    article = { summary: p.summary, quickAnswer: p.quickAnswer, faq: p.faq, sources: p.sources, markdown: p.markdown };
    input('up-title').value = (p.headline ?? '').slice(0, 90);
    $<HTMLSelectElement>('up-category').value = p.category ?? 'neighbourhoods';
    input('up-author').value = p.author ?? '';
    input('up-role').value = p.authorTitle ?? '';
    tick('related', p.related ?? []);
    tick('relatedServices', p.relatedServices ?? []);
    preview();
  }

  function load(html: string) {
    if (!html.trim()) return;
    let r: Imported | null = null;
    try {
      r = convertHtml(html);
    } catch {}
    if (!r?.headline || !r.markdown) {
      show('up-check', false);
      show('up-go', false);
      return say('That does not look like a whole article. Copy all of the HTML of the article and paste it again.', true);
    }
    editing = '';
    const about = `${r.headline} ${r.summary ?? ''}`;
    $('up-notes').replaceChildren(...r.warnings.map((w) => Object.assign(document.createElement('li'), { textContent: w.replace(/^the /, 'The ') })));
    fill({
      ...r,
      category: guessCategory(r.headline),
      author: remember('up-author'),
      authorTitle: remember('up-role'),
      related: hoodsIn(about, 3),
      relatedServices: servicesIn(about, 2),
    });
  }

  async function open(slug: string) {
    say('Opening the post…');
    const { data } = await api('get', { slug });
    if (data.error) return say(data.error, true);
    editing = slug;
    $('up-notes').replaceChildren();
    fill(data.post);
    $('up-check').scrollIntoView();
  }

  async function save(draft: boolean) {
    say(draft ? 'Saving the draft…' : 'Publishing…');
    remember('up-author', input('up-author').value.trim());
    remember('up-role', input('up-role').value.trim());
    let { status: code, data } = await api('publish', { post: post(draft), replace: !!editing });
    if (code === 409 && data.error === 'exists') {
      const question = draft
        ? 'A post with this title is live on the website. Take it down and keep this version as a draft?'
        : 'A post with this title is already on the website. Replace it with this one?';
      if (!confirm(question)) return say('Nothing was changed.');
      ({ data } = await api('publish', { post: post(draft), replace: true }));
    }
    if (data.error) return say(data.error, true);
    editing = post().slug;
    const done = $('up-done-text');
    done.replaceChildren();
    if (data.draft) {
      done.append(Object.assign(document.createElement('strong'), { textContent: 'Draft saved.' }), ' It is not on the website. Press Edit next to it in the list below to finish it later.');
    } else {
      const link = Object.assign(document.createElement('a'), { href: data.url, target: '_blank', rel: 'noopener', textContent: 'Open the post' });
      done.append(Object.assign(document.createElement('strong'), { textContent: 'Your post is live.' }), ' ', link);
    }
    show('up-done', true);
    say(data.draft ? 'Draft saved.' : 'Your post is live on the website.');
    list();
  }

  $('up-login').addEventListener('submit', async (e) => {
    e.preventDefault();
    say('Signing in…');
    const { data } = await api('login', { password: input('up-password').value });
    if (data.error) return say(data.error, true);
    input('up-password').value = '';
    start();
  });
  $('up-html').addEventListener('input', (e) => load((e.target as HTMLTextAreaElement).value));
  $('up-file').addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) load(await file.text());
  });
  $('up-details').addEventListener('change', preview);
  $('up-details').addEventListener('submit', (e) => e.preventDefault());
  $('up-publish').addEventListener('click', () => save(false));
  $('up-draft').addEventListener('click', () => save(true));
  $('up-again').addEventListener('click', () => {
    article = null;
    editing = '';
    $<HTMLTextAreaElement>('up-html').value = '';
    ['up-check', 'up-go', 'up-done'].forEach((id) => show(id, false));
    say('Ready for the next post.');
    window.scrollTo(0, 0);
  });
  $('up-logout').addEventListener('click', async () => {
    await api('logout', {});
    start();
  });
  start();
</script>

<style>
  .up [hidden] {
    display: none;
  }
  .up {
    max-width: 920px;
    padding-block: var(--sp-7) var(--sp-8);
    font-size: 1.1rem;
  }
  .up h2 {
    font-size: var(--step-2);
    margin-bottom: var(--sp-3);
  }
  .up__box {
    display: grid;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
    padding: var(--sp-6);
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
  }
  .up__num {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    font-size: 1rem;
  }
  .up label {
    font-weight: 700;
  }
  .up input:not([type='file'], [type='checkbox']),
  .up select,
  .up textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    font: inherit;
    border: 2px solid var(--rule);
    border-radius: var(--radius);
    background: #fff;
  }
  .up textarea {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.85rem;
  }
  .up input:focus,
  .up select:focus,
  .up textarea:focus {
    outline: 3px solid var(--brand);
    outline-offset: 1px;
  }
  .up__file {
    color: var(--brand);
    text-decoration: underline;
    cursor: pointer;
  }
  .up__file input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .up__status {
    margin-top: var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    border-radius: var(--radius);
    background: var(--mist);
    font-weight: 700;
  }
  .up__status:empty {
    display: none;
  }
  .up__status--bad {
    background: #fdecea;
    color: #8a1c12;
  }
  .up__notes:empty {
    display: none;
  }
  .up__notes {
    margin: 0;
    padding-left: 1.2em;
    color: var(--text-muted);
  }
  #up-preview {
    width: 100%;
    height: 75vh;
    border: 2px solid var(--rule);
    border-radius: var(--radius);
  }
  .up__big {
    min-height: 64px;
    font-size: 1.1rem;
  }
  .up__done {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-5);
    background: #e8f4ec;
    border-radius: var(--radius);
  }
  .up__list {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .up__hint {
    color: var(--text-muted);
  }
  .up__fields {
    display: grid;
    gap: var(--sp-3);
  }
  .up__pair {
    display: grid;
    gap: var(--sp-3);
  }
  .up__pair > div {
    display: grid;
    gap: var(--sp-2);
  }
  .up fieldset {
    margin: var(--sp-3) 0 0;
    padding: 0;
    border: 0;
  }
  .up legend {
    margin-bottom: var(--sp-3);
    font-weight: 700;
  }
  .up__ticks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: var(--sp-2) var(--sp-4);
  }
  .up__ticks label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    font-weight: 400;
    cursor: pointer;
  }
  .up__ticks input {
    width: 1.4rem;
    height: 1.4rem;
    accent-color: var(--brand);
  }
  .up__state {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
  }
  .up__actions {
    display: flex;
    gap: var(--sp-2);
  }
  @media (min-width: 640px) {
    .up__pair {
      grid-template-columns: 1fr 1fr;
    }
  }
  .up__list li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
  }
</style>
