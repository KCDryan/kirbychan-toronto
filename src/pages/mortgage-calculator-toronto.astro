---
import CreditedPhoto from '../components/CreditedPhoto.astro';
import Page from '../layouts/Page.astro';
import { cad } from '../lib/format';
import { minDown, payment } from '../lib/mortgage';
import monthly from '../data/trreb-monthly.json';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Mortgage Calculator', path: '/mortgage-calculator-toronto/' },
];

// Worked examples at the City of Toronto medians by property type from the latest Market Watch.
const examples = monthly.torontoByType
  .filter((r) => ['Condo apartment', 'Condo townhouse', 'Semi-detached', 'Detached'].includes(r.type))
  .sort((a, b) => a.median - b.median)
  .map((r) => {
    const down = Math.round(minDown(r.median));
    const loan = r.median - down;
    return { type: r.type, price: r.median, down, loan, pay: Math.round(payment(loan, 0.04, 25)), pay30: Math.round(payment(loan, 0.04, 30)) };
  });

const faq = [
  {
    q: 'What is the minimum down payment on a Toronto home?',
    a: 'It depends on the price. Up to $500,000 you need 5%. Between $500,000 and $1.5 million you need 5% of the first $500,000 and 10% of everything above it. From $1.5 million up the minimum is 20% of the whole price.',
  },
  {
    q: 'Can I take a 30-year amortization?',
    a: 'With less than 20% down, a 30-year amortization is available to first-time buyers and to buyers of a newly built home. Other insured mortgages are limited to 25 years. With 20% or more down, ask your lender what it offers.',
  },
  {
    q: 'What rate will the lender test me at?',
    a: 'The greater of your contract rate plus 2% or 5.25%. The calculator works out that qualifying payment for you, because it is the figure your income has to support, not the payment you will actually make.',
  },
  {
    q: 'Does the payment include mortgage loan insurance?',
    a: 'No. A mortgage with less than 20% down usually needs mortgage loan insurance and the premium is normally added to the loan, so the real balance and payment will be a little higher. Your lender or broker will quote the premium.',
  },
  {
    q: 'Is this a mortgage offer?',
    a: 'No. It is a planning estimate using a rate you choose. Only a lender or licensed mortgage broker can set your actual rate, fees and approval.',
  },
];

const sources = [
  { name: 'Financial Consumer Agency of Canada, Saving for a down payment', url: 'https://www.canada.ca/en/financial-consumer-agency/services/mortgages/down-payment.html' },
  { name: 'Financial Consumer Agency of Canada, Mortgage terms and amortization', url: 'https://www.canada.ca/en/financial-consumer-agency/services/mortgages/mortgage-terms-amortization.html' },
  { name: 'OSFI, Minimum qualifying rate for uninsured mortgages', url: 'https://www.osfi-bsif.gc.ca/en/supervision/financial-institutions/banks/minimum-qualifying-rate-uninsured-mortgages' },
  { name: `TRREB Market Watch, ${monthly.period}`, url: monthly.sourceUrl },
  { name: 'Interest Act, section 6', url: 'https://laws-lois.justice.gc.ca/eng/acts/I-15/page-1.html' },
];
---

<Page
  title="Toronto Mortgage Calculator with Stress Test"
  description="Estimate the monthly payment on a Toronto home, the minimum down payment and the stress test payment lenders qualify you at, with examples at Toronto medians."
  eyebrow="Toronto, Ontario"
  h1="Toronto mortgage payment calculator"
  lede="Put in a price, a down payment and a rate to see the monthly payment, the smallest down payment allowed and the higher stress test payment a lender will check your income against."
  crumbs={crumbs}
  faq={faq}
>
  <section class="section">
    <div class="wrap-narrow">
      <form class="calc" onsubmit="return false">
        <div class="calc__row">
          <label for="m-price">Purchase price</label>
          <div class="calc__input"><span aria-hidden="true">$</span><input id="m-price" inputmode="numeric" autocomplete="off" value="1,000,000" /></div>
        </div>
        <div class="calc__row">
          <label for="m-down">Down payment</label>
          <div class="calc__input"><span aria-hidden="true">$</span><input id="m-down" inputmode="numeric" autocomplete="off" value="75,000" /></div>
        </div>
        <div class="calc__pair">
          <div class="calc__row">
            <label for="m-rate">Interest rate</label>
            <div class="calc__input"><input id="m-rate" inputmode="decimal" autocomplete="off" value="4.00" /><span aria-hidden="true">%</span></div>
          </div>
          <div class="calc__row">
            <label for="m-years">Amortization</label>
            <select id="m-years" class="calc__input">
              <option value="25" selected>25 years</option>
              <option value="30">30 years</option>
            </select>
          </div>
        </div>
        <dl class="calc__out" aria-live="polite">
          <div><dt>Minimum down payment</dt><dd id="m-min">$75,000</dd></div>
          <div><dt>Mortgage amount, before insurance</dt><dd id="m-loan">{cad(925000)}</dd></div>
          <div class="calc__total"><dt>Monthly payment</dt><dd id="m-pay">{cad(Math.round(payment(925000, 0.04, 25)))}</dd></div>
          <div><dt>Stress test rate</dt><dd id="m-qrate">6.00%</dd></div>
          <div><dt>Payment you must qualify at</dt><dd id="m-qpay">{cad(Math.round(payment(925000, 0.06, 25)))}</dd></div>
        </dl>
        <p class="calc__warn" id="m-warn" hidden>This is below the minimum down payment for that price.</p>
        <p class="calc__note">
          An estimate, not a quote. It leaves out mortgage loan insurance, which is typically needed
          with less than 20% down and raises the payment. The rate is your own assumption.
        </p>
      </form>

      <CreditedPhoto slug="willowdale" />

      <div class="prose">
        <h2>How much you need to put down</h2>
        <table>
          <thead><tr><th>Purchase price</th><th>Minimum down payment</th></tr></thead>
          <tbody>
            <tr><td>$500,000 or less</td><td>5% of the price</td></tr>
            <tr><td>$500,000 to $1.5 million</td><td>5% of the first $500,000 and 10% of the rest</td></tr>
            <tr><td>$1.5 million or more</td><td>20% of the price</td></tr>
          </tbody>
        </table>
        <p>
          Put down less than 20% and the mortgage will usually need loan insurance. The
          <a href="/first-time-home-buyers-toronto/">first-time home buyer guide</a> goes through these rules
          with Toronto prices and the savings plans that help.
        </p>

        <h2>Payments at Toronto's median prices</h2>
        <p>
          These use the City of Toronto median for each property type in {monthly.period} (TRREB), the
          minimum down payment and an illustrative 4.00% rate, before any mortgage loan insurance. They are
          examples, not quotes. A 30-year amortization is only open to some insured buyers.
        </p>
        <table>
          <thead><tr><th>Property type</th><th>Median price</th><th>Minimum down</th><th>Mortgage</th><th>25 years</th><th>30 years</th></tr></thead>
          <tbody>
            {
              examples.map((e) => (
                <tr>
                  <td>{e.type}</td>
                  <td>{cad(e.price)}</td>
                  <td>{cad(e.down)}</td>
                  <td>{cad(e.loan)}</td>
                  <td>{cad(e.pay)}</td>
                  <td>{cad(e.pay30)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <h2>The qualifying payment decides the budget</h2>
        <p>
          Lenders approve you against a stress test payment calculated at the greater of 5.25% or your
          contract rate plus 2%. Your income has to carry that higher payment, which is why it caps what you
          can borrow. Our post on the <a href="/blog/mortgage-stress-test-toronto/">mortgage stress test in Toronto</a>
          shows how it plays out at different incomes.
        </p>

        <h2>Costs the payment leaves out</h2>
        <p>
          Owning also means property tax, utilities, home insurance and, for a condo, monthly fees. At the
          start you pay two land transfer taxes in Toronto plus legal and closing costs. Run the
          <a href="/land-transfer-tax-calculator-toronto/">land transfer tax calculator</a> on the same price or
          <a href="/contact/">ask us</a> for the full picture on a home you like.
        </p>

        <h2>Sources</h2>
        <ul>
          {sources.map((s) => <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.name}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Page>

<script>
  // Same formulas as the build: src/lib/mortgage.ts, which carries the self-check.
  import { minDown, payment, qualifyingRate } from '../lib/mortgage';

  const el = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (id: string) => Number((el(id).value || '').replace(/[^0-9.]/g, '')) || 0;
  const money = (n: number) => '$' + Math.round(n).toLocaleString('en-CA');
  let downTouched = false;
  const run = () => {
    const price = num('m-price');
    const min = minDown(price);
    if (!downTouched) el('m-down').value = Math.round(min).toLocaleString('en-CA');
    const down = num('m-down');
    const rate = num('m-rate') / 100;
    const yrs = Number(el('m-years').value);
    const loan = Math.max(0, price - down);
    const q = qualifyingRate(rate);
    el('m-min').textContent = money(min);
    el('m-loan').textContent = money(loan);
    el('m-pay').textContent = money(payment(loan, rate, yrs));
    el('m-qrate').textContent = (q * 100).toFixed(2) + '%';
    el('m-qpay').textContent = money(payment(loan, q, yrs));
    el('m-warn').hidden = !(price && down < Math.round(min));
  };
  for (const id of ['m-price', 'm-rate', 'm-years']) el(id).addEventListener('input', run);
  el('m-down').addEventListener('input', () => { downTouched = true; run(); });
  for (const id of ['m-price', 'm-down']) {
    el(id).addEventListener('blur', () => { const v = num(id); if (v) el(id).value = v.toLocaleString('en-CA'); });
  }
  run();
</script>

<style>
  .calc {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-5);
    margin-bottom: var(--sp-6);
    background: var(--mist);
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  .calc__row { display: grid; gap: 0.35rem; }
  .calc__row label { font-weight: 700; }
  .calc__pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3); }
  .calc__input {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.8rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 6px;
    font: inherit;
    font-size: 1.15rem;
  }
  .calc__input input { flex: 1; border: 0; font: inherit; background: transparent; min-width: 0; }
  .calc__input:focus-within { outline: 2px solid var(--brand); outline-offset: 2px; }
  .calc__out { display: grid; gap: var(--sp-2); margin: 0; }
  .calc__out div { display: flex; justify-content: space-between; gap: var(--sp-3); border-bottom: 1px solid var(--rule); padding-bottom: var(--sp-2); }
  .calc__out dd { margin: 0; font-variant-numeric: tabular-nums; font-weight: 700; }
  .calc__total { font-size: 1.2rem; color: var(--brand); }
  .calc__warn { color: #9a3412; font-weight: 700; margin: 0; }
  .calc__note { font-size: 0.875rem; margin: 0; }
  @media (max-width: 480px) { .calc__pair { grid-template-columns: 1fr; } }
</style>
