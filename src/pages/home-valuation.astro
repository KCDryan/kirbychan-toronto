---
import Page from '../layouts/Page.astro';
import LeadForm from '../components/LeadForm.astro';
import Testimonials from '../components/Testimonials.astro';
import site from '../data/site.json';
import stories from '../data/client-stories.json';
import { cad } from '../lib/format';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Free Home Valuation', path: '/home-valuation/' },
];

const faq = [
  {
    q: 'Does the valuation cost anything?',
    a: 'No. It is free and you are under no obligation to list with us afterwards.',
  },
  {
    q: 'Is it an automated estimate?',
    a: 'No. Kirby and the team read the recent sales of comparable homes near yours, allow for size, condition, lot and features, then send you a range with the reasoning behind it.',
  },
  {
    q: 'How is this different from an appraisal?',
    a: 'A valuation is a real estate team\'s opinion of market value from comparable sales, meant for planning. A lender, a court or an estate may need a formal appraisal from a qualified appraiser instead.',
  },
  {
    q: 'Can I get a valuation for a parent\'s home or an estate property?',
    a: 'Yes. Estate trustees and families often ask for one early to plan the sale. Tell us in the form who you are acting for.',
  },
  {
    q: 'What happens after I send the form?',
    a: 'We get in touch to confirm a few details about the home, then send you the valuation. If a move is on the horizon we can also talk about timing.',
  },
];
---

<Page
  title="Toronto Home Value Estimate: Free Valuation"
  description="What is your Toronto home worth? Request a free, no-obligation valuation from Kirby Chan & Co. Real Estate Team, built from recent sales of similar homes."
  eyebrow="Toronto, Ontario"
  h1="What is your Toronto home worth today?"
  lede="A free valuation prepared by Kirby Chan and the team from the sales of similar homes near yours. Useful whether you plan to sell soon, are thinking about downsizing or are settling an estate."
  crumbs={crumbs}
  faq={faq}
  tone="sand"
>
  <section class="section">
    <div class="wrap val-grid">
      <div>
        <LeadForm
          heading="Request your free home valuation"
          intro="About a minute to fill in. We use your details only to prepare the valuation and contact you about it."
          source="home-valuation"
          askAddress
          defaultIntent="Selling"
          submitLabel="Get my free valuation"
        />
      </div>
      <aside class="val-side">
        <h2>What you receive</h2>
        <ol>
          <li>A price range drawn from recent sales of similar homes nearby</li>
          <li>The sales we used and how your home compares with each</li>
          <li>Our view on which preparation, if any, would pay for itself</li>
          <li>For downsizers and estate trustees, a first outline of timing</li>
        </ol>
        <p class="val-side__note">
          Rather talk it through? Call <a href={site.contact.phoneHref}>{site.contact.phone}</a>. The team works
          in ten languages.
        </p>
        <p class="val-side__note">
          Planning a move to something smaller? Start with our <a href="/downsizing-toronto/">Toronto downsizing guide</a>.
        </p>
      </aside>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Published results</p>
        <h2>Homes the team has sold</h2>
        <p class="lede">List and sale prices as the team published them on kirbychanandco.com, with the area each home was in. No two homes or markets are alike and past results do not predict what any other home will sell for.</p>
      </div>
      <ul class="val-stories" role="list">
        {
          stories.stories.map((s) => (
            <li>
              <p class="val-stories__area">{s.area}</p>
              <p class="val-stories__prices">Listed {cad(s.listed)} <span aria-hidden="true">&middot;</span> Sold {cad(s.sold)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Testimonials />
</Page>

<style>
  .val-grid {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }
  .val-side {
    padding: var(--sp-6);
    background: #fff;
    border: 1px solid var(--rule);
    border-top: 3px solid var(--brass);
    border-radius: var(--radius-lg);
  }
  .val-side h2 {
    font-size: var(--step-2);
    margin-bottom: var(--sp-4);
  }
  .val-side ol {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
    padding-inline-start: 1.2em;
  }
  .val-side__note {
    margin-top: var(--sp-5);
    font-size: 0.92rem;
    color: var(--text-muted);
  }
  .val-stories {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: var(--sp-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .val-stories li {
    padding: var(--sp-5);
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
  }
  .val-stories__area {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .val-stories__prices {
    margin-top: var(--sp-2);
    font-weight: 700;
  }
  @media (min-width: 900px) {
    .val-grid {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--sp-8);
    }
  }
</style>
