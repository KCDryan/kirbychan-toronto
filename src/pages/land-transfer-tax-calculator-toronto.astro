---
import CreditedPhoto from '../components/CreditedPhoto.astro';
import Page from '../layouts/Page.astro';
import { cad } from '../lib/format';
import { ontarioLtt, torontoMltt } from '../lib/ltt';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Land Transfer Tax Calculator', path: '/land-transfer-tax-calculator-toronto/' },
];

// Maximum first-time buyer refunds: Ontario (ontario.ca) and the City of Toronto rebate (toronto.ca).
const ON_REFUND = 4000;
const TO_REFUND = 4475;
const START = 1000000;

const examples = [650000, 1000000, 1500000, 2500000, 3500000, 5000000].map((price) => {
  const on = ontarioLtt(price);
  const to = torontoMltt(price);
  return { price, on, to, total: on + to, firstTime: on + to - Math.min(on, ON_REFUND) - Math.min(to, TO_REFUND) };
});
const at = (p: number) => ({ on: ontarioLtt(p), to: torontoMltt(p) });
const m1 = at(1000000);
const m35 = at(3500000);

const faq = [
  {
    q: 'Who pays land transfer tax in Toronto?',
    a: 'The buyer. A purchase in the City of Toronto carries two taxes: Ontario land transfer tax and the City of Toronto municipal land transfer tax. Both are due when the transfer is registered on closing and your lawyer pays them from your closing funds.',
  },
  {
    q: 'How much land transfer tax is there on a $1,000,000 Toronto home?',
    a: `${cad(m1.on)} to Ontario and ${cad(m1.to)} to the City, a total of ${cad(m1.on + m1.to)}. An eligible first-time buyer can recover up to $4,000 of the provincial tax and up to $4,475 of the municipal tax, bringing it to ${cad(m1.on + m1.to - ON_REFUND - TO_REFUND)}.`,
  },
  {
    q: 'What changed for Toronto homes over $3 million on April 1, 2026?',
    a: `The City added higher municipal rates for homes with one or two single family residences: 4.4% on the part of the price from $3 million to $4 million, then 5.45%, 6.5%, 7.55% and 8.6% in steps up to over $20 million. On a $3,500,000 home the municipal tax is now ${cad(m35.to)}.`,
  },
  {
    q: 'What does a first-time buyer need to qualify for both rebates?',
    a: 'Broadly the same things for both: be at least 18, never have owned a home or an interest in one anywhere in the world and live in the home as your principal residence within nine months. The rebates must be claimed within 18 months of registration. Your lawyer usually claims them on closing.',
  },
  {
    q: 'Would the same home cost less tax in Markham?',
    a: `Yes. Toronto's municipal land transfer tax applies to property in the City of Toronto, so a Markham purchase carries the Ontario tax only. On $1,000,000 that is ${cad(m1.on)} in Markham against ${cad(m1.on + m1.to)} in Toronto, before refunds.`,
  },
  {
    q: 'Is this calculator exact?',
    a: 'It uses the published rates for a home with one or two single family residences. Other property types stay at 2% above $400,000 for the municipal tax. The value of consideration can also include more than the price. The City also charges an administration fee. Your lawyer confirms the final figure.',
  },
];

const sources = [
  { name: 'Ontario Ministry of Finance, Calculating land transfer tax', url: 'https://www.ontario.ca/document/land-transfer-tax/calculating-land-transfer-tax' },
  { name: 'Ontario Ministry of Finance, Land transfer tax refunds for first-time homebuyers', url: 'https://www.ontario.ca/document/land-transfer-tax/land-transfer-tax-refunds-first-time-homebuyers' },
  { name: 'City of Toronto, Municipal land transfer tax rates and fees', url: 'https://www.toronto.ca/services-payments/property-taxes-utilities/municipal-land-transfer-tax-mltt/municipal-land-transfer-tax-mltt-rates-and-fees/' },
  { name: 'City of Toronto, Municipal land transfer tax rebate opportunities', url: 'https://www.toronto.ca/services-payments/property-taxes-utilities/municipal-land-transfer-tax-mltt/municipal-land-transfer-tax-mltt-rebate-opportunities/' },
  { name: 'City of Toronto, Municipal land transfer tax information', url: 'https://www.toronto.ca/services-payments/property-taxes-utilities/municipal-land-transfer-tax-mltt/municipal-land-transfer-tax-mltt-information/' },
];
---

<Page
  title="Toronto Land Transfer Tax Calculator (2026)"
  description="Calculate Ontario and Toronto municipal land transfer tax on a Toronto home, with both first-time buyer rebates, the April 2026 luxury rates and a Markham comparison."
  eyebrow="Toronto, Ontario"
  h1="Toronto land transfer tax calculator"
  lede="Enter a price to see both taxes on a Toronto home: the Ontario land transfer tax and the City's municipal land transfer tax, what a first-time buyer pays after both rebates and what the same price would cost in Markham."
  crumbs={crumbs}
  faq={faq}
>
  <section class="section">
    <div class="wrap-narrow">
      <form class="calc" id="ltt" onsubmit="return false">
        <label for="ltt-price">Purchase price</label>
        <div class="calc__input">
          <span aria-hidden="true">$</span>
          <input id="ltt-price" inputmode="numeric" autocomplete="off" value={START.toLocaleString('en-CA')} aria-describedby="ltt-note" />
        </div>
        <label class="calc__check"><input type="checkbox" id="ltt-first" /> I qualify as a first-time buyer</label>
        <dl class="calc__out" aria-live="polite">
          <div><dt>Ontario land transfer tax</dt><dd id="ltt-on">{cad(ontarioLtt(START))}</dd></div>
          <div><dt>Toronto municipal land transfer tax</dt><dd id="ltt-to">{cad(torontoMltt(START))}</dd></div>
          <div><dt>First-time buyer rebates</dt><dd id="ltt-refund">$0</dd></div>
          <div class="calc__total"><dt>You pay in Toronto</dt><dd id="ltt-total">{cad(ontarioLtt(START) + torontoMltt(START))}</dd></div>
          <div><dt>The same price in Markham</dt><dd id="ltt-mk">{cad(ontarioLtt(START))}</dd></div>
        </dl>
        <p id="ltt-note" class="calc__note">
          For a home with one or two single family residences, at the rates published by Ontario and
          the City of Toronto, excluding the City's administration fee. Your lawyer confirms the final amount.
        </p>
      </form>

      <CreditedPhoto slug="riverdale" />

      <div class="prose">
        <h2>Two taxes on every Toronto purchase</h2>
        <p>
          Ontario charges land transfer tax on every purchase in the province. Since February 1, 2008
          the City of Toronto has charged its own municipal land transfer tax as well, on property in
          the City of Toronto. Both use graduated rates and both are paid when the transfer is registered
          on closing, so a Toronto buyer needs roughly twice the land transfer tax of a buyer at the same
          price in Markham, Mississauga or Vaughan.
        </p>

        <h2>Land transfer tax at common Toronto prices</h2>
        <table>
          <thead>
            <tr><th>Price</th><th>Ontario</th><th>Toronto</th><th>Total</th><th>First-time buyer</th></tr>
          </thead>
          <tbody>
            {
              examples.map((e) => (
                <tr>
                  <td>{cad(e.price)}</td>
                  <td>{cad(e.on)}</td>
                  <td>{cad(e.to)}</td>
                  <td>{cad(e.total)}</td>
                  <td>{cad(e.firstTime)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p>
          The last column subtracts the maximum refunds, $4,000 from Ontario and $4,475 from the City.
          Markham buyers pay the Ontario column only.
        </p>

        <h2>Toronto municipal land transfer tax rates</h2>
        <p>For a home with one or two single family residences. The rates over $3,000,000 took effect on April 1, 2026.</p>
        <table>
          <thead><tr><th>Portion of the price</th><th>Rate</th></tr></thead>
          <tbody>
            <tr><td>Up to $55,000</td><td>0.5%</td></tr>
            <tr><td>$55,000 to $250,000</td><td>1.0%</td></tr>
            <tr><td>$250,000 to $400,000</td><td>1.5%</td></tr>
            <tr><td>$400,000 to $2,000,000</td><td>2.0%</td></tr>
            <tr><td>$2,000,000 to $3,000,000</td><td>2.5%</td></tr>
            <tr><td>$3,000,000 to $4,000,000</td><td>4.4%</td></tr>
            <tr><td>$4,000,000 to $5,000,000</td><td>5.45%</td></tr>
            <tr><td>$5,000,000 to $10,000,000</td><td>6.5%</td></tr>
            <tr><td>$10,000,000 to $20,000,000</td><td>7.55%</td></tr>
            <tr><td>Over $20,000,000</td><td>8.6%</td></tr>
          </tbody>
        </table>
        <p>
          The Ontario rates are the same as the first four rows, then 2.5% on everything over $2,000,000.
          Foreign buyers of certain residential property also pay the City's 10% Municipal Non-Resident
          Speculation Tax, in effect since January 1, 2025, on top of the municipal land transfer tax.
        </p>

        <h2>The two first-time buyer rebates</h2>
        <p>
          Ontario refunds up to $4,000 of its tax, which covers the whole provincial tax on the first
          $368,000 of the price. The City rebates up to $4,475 of its tax. To qualify you must be at
          least 18, must never have owned a home or an interest in one anywhere in the world and must
          live in the home as your principal residence within nine months. The City also requires that a
          spouse has not owned a home while married to you and that you are a Canadian citizen or
          permanent resident or become one within 18 months. Claims made after closing must be filed
          within 18 months of registration. The
          <a href="/first-time-home-buyers-toronto/">first-time home buyer guide</a> sets these rebates next
          to the FHSA and the Home Buyers' Plan. Our post on
          <a href="/blog/land-transfer-tax-toronto/">land transfer tax in Toronto</a> works through them in detail.
        </p>

        <h2>Plan the rest of your closing costs</h2>
        <p>
          Land transfer tax is the largest single closing cost for most Toronto buyers. Legal fees, title
          insurance, adjustments and the move itself come on top. Read
          <a href="/blog/closing-costs-buying-home-toronto/">closing costs for Toronto buyers</a> or
          <a href="/contact/">ask us</a> to total up a purchase you are considering.
        </p>

        <h2>Sources</h2>
        <ul>
          {sources.map((s) => <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.name}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Page>

<script>
  // One rate table for the page and the build: src/lib/ltt.ts, with its own self-check.
  import { ontarioLtt, torontoMltt } from '../lib/ltt';

  const money = (n: number) => '$' + n.toLocaleString('en-CA');
  const el = (id: string) => document.getElementById(id) as HTMLInputElement;
  const price = () => Number((el('ltt-price').value || '').replace(/[^0-9.]/g, '')) || 0;
  const run = () => {
    const v = price();
    const on = ontarioLtt(v);
    const to = torontoMltt(v);
    const refund = el('ltt-first').checked ? Math.min(on, 4000) + Math.min(to, 4475) : 0;
    el('ltt-on').textContent = money(on);
    el('ltt-to').textContent = money(to);
    el('ltt-refund').textContent = money(refund);
    el('ltt-total').textContent = money(on + to - refund);
    el('ltt-mk').textContent = money(on);
  };
  el('ltt-price').addEventListener('input', run);
  el('ltt-price').addEventListener('blur', () => {
    const v = price();
    if (v) el('ltt-price').value = v.toLocaleString('en-CA');
  });
  el('ltt-first').addEventListener('change', run);
  run();
</script>

<style>
  .calc {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-5);
    margin-bottom: var(--sp-6);
    background: var(--mist);
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  .calc label { font-weight: 700; }
  .calc__input {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.8rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 6px;
    font-size: 1.25rem;
  }
  .calc__input input { flex: 1; border: 0; font: inherit; background: transparent; min-width: 0; }
  .calc__input:focus-within { outline: 2px solid var(--brand); outline-offset: 2px; }
  .calc__check { font-weight: 400 !important; display: flex; gap: 0.5rem; align-items: center; }
  .calc__out { display: grid; gap: var(--sp-2); margin: 0; }
  .calc__out div { display: flex; justify-content: space-between; gap: var(--sp-3); border-bottom: 1px solid var(--rule); padding-bottom: var(--sp-2); }
  .calc__out dd { margin: 0; font-variant-numeric: tabular-nums; font-weight: 700; }
  .calc__total { font-size: 1.2rem; color: var(--brand); }
  .calc__note { font-size: 0.875rem; margin: 0; }
</style>
