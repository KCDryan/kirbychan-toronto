---
import CreditedPhoto from '../components/CreditedPhoto.astro';
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import DownsizingPromo from '../components/DownsizingPromo.astro';
import { neighbourhoodPath } from '../lib/format';
import { HUBS } from '../lib/neighbourhood-hubs';

export const getStaticPaths = (() => HUBS.map((hub) => ({ params: { who: hub.slug }, props: { hub } }))) satisfies GetStaticPaths;

const { hub } = Astro.props as { hub: (typeof HUBS)[number] };
const all = await getCollection('neighbourhoods', ({ data }) => !data.draft);
const bySlug = new Map(all.map((n) => [n.id, n]));
const need = (slug: string) => {
  const n = bySlug.get(slug);
  if (!n) throw new Error(`Hub "${hub.slug}" names unknown neighbourhood "${slug}"`);
  return n;
};
const picks = hub.picks.map((p) => ({ ...p, n: need(p.slug) }));
const harder = hub.harder?.slugs.map(need) ?? [];

// Sources: every source the chosen neighbourhood guides cite, once each.
const seen = new Set<string>();
const sources = picks
  .flatMap((p) => p.n.data.sources)
  .filter((s) => !seen.has(s.url) && seen.add(s.url));

const path = `/best-toronto-neighbourhoods-for-${hub.slug}/`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Neighbourhoods', path: '/neighbourhoods/' },
  { name: hub.h1, path },
];
const others = HUBS.filter((h) => h.slug !== hub.slug);
const outroLinks: Record<string, [string, string][]> = {
  downsizing: [['/downsizing-toronto/', 'Toronto downsizing guide'], ['/blog/toronto-downsizing-costs/', 'what downsizing costs in Toronto'], ['/blog/toronto-neighbourhoods-for-downsizing/', 'downsizing neighbourhoods by property type']],
  families: [['/upsizing-toronto/', 'guide to moving up to a bigger home'], ['/land-transfer-tax-calculator-toronto/', 'land transfer tax calculator'], ['/mortgage-calculator-toronto/', 'mortgage calculator']],
  commuters: [['/blog/toronto-subway-commute-by-neighbourhood/', 'Toronto subway commute guide'], ['/relocating-to-toronto/', 'relocating to Toronto guide']],
};
---

<Page title={hub.title} description={hub.description} eyebrow="Toronto neighbourhoods" h1={hub.h1} lede={hub.lede} crumbs={crumbs} faq={hub.faq}>
  <section class="section">
    <div class="wrap-narrow prose">
      {hub.intro.map((p) => <p>{p}</p>)}
      {hub.photo && <CreditedPhoto slug={hub.photo} priority />}
      {
        hub.slug === 'downsizing' && (
          <div class="for-sale-now">
            <p><strong>See what is for sale in Toronto right now:</strong></p>
            <p class="for-sale-now__links">
              <a class="btn btn--primary" href="/homes-for-sale/bungalows/">Bungalows</a>
              <a class="btn btn--primary" href="/homes-for-sale/condos/">Condo apartments</a>
              <a class="btn btn--primary" href="/homes-for-sale/townhouses/">Townhouses</a>
            </p>
          </div>
        )
      }

      <h2>At a glance</h2>
      <table>
        <thead><tr><th>Neighbourhood</th><th>Housing</th><th>{hub.bandLabel}</th></tr></thead>
        <tbody>
          {
            picks.map(({ n }) => (
              <tr>
                <td><a href={neighbourhoodPath(n.id)}>{n.data.name}</a></td>
                <td>{n.data.quickStats.propertyTypes}</td>
                <td>
                  {n.data.priceBands.filter((b) => hub.bands.test(b.band)).map((b) => (
                    <div>{b.band}: {b.range}</div>
                  ))}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p>
        Prices are the TRREB community figures for April to June 2026 in each neighbourhood guide,
        split by TRREB community where a guide covers two. Commutes are counted in stops on the TTC map
        to Union station.
      </p>

      {
        picks.map(({ n, why }) => (
          <>
            <h2>{n.data.name}</h2>
            <CreditedPhoto slug={n.id} />
            <p>{why}</p>
            <p><strong>Getting around:</strong> {n.data.quickStats.commute}.</p>
            <p><a href={neighbourhoodPath(n.id)}>Read the {n.data.name} neighbourhood guide</a></p>
          </>
        ))
      }

      {
        hub.harder && (
          <>
            <h2>{hub.harder.heading}</h2>
            <p>{hub.harder.text}</p>
            <ul>
              {harder.map((n) => (
                <li><a href={neighbourhoodPath(n.id)}>{n.data.name}</a>: {n.data.quickStats.propertyTypes}.</li>
              ))}
            </ul>
          </>
        )
      }

      <h2>{hub.outro.heading}</h2>
      {hub.outro.paragraphs.map((p) => <p>{p}</p>)}
      <ul>
        {outroLinks[hub.slug]?.map(([href, label]) => <li><a href={href}>{label.charAt(0).toUpperCase() + label.slice(1)}</a></li>)}
        <li><a href="/neighbourhoods/">All eighteen Toronto neighbourhood guides</a></li>
        {others.map((o) => <li><a href={`/best-toronto-neighbourhoods-for-${o.slug}/`}>{o.h1}</a></li>)}
      </ul>

      <p>
        Every neighbourhood is open to every buyer. These pages group them by the homes and commutes
        people in each situation ask us about. <a href="/contact/">Talk to us</a> about your own list.
      </p>
    </div>

    <div class="wrap-narrow" style="margin-top: var(--sp-6)">
      <DownsizingPromo />
    </div>

    <div class="wrap-narrow prose">
      <h2>Sources</h2>
      <ul>
        {sources.map((s) => <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.name}</a></li>)}
      </ul>
    </div>
  </section>
</Page>

<style>
  .for-sale-now { padding: var(--sp-5); background: var(--mist); border: 1px solid var(--rule); border-radius: var(--radius-lg); }
  .for-sale-now p { margin: 0; }
  .for-sale-now__links { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-3) !important; }
</style>
