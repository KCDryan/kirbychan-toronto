---
import Page from '../layouts/Page.astro';
import NeighbourhoodGrid from '../components/NeighbourhoodGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Cta from '../components/Cta.astro';
import site from '../data/site.json';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Buyers', path: '/buyers/' },
];

const steps = [
  {
    title: 'Set the budget from the payment',
    body: 'A lender tells you the most it will lend. We start from the monthly cost you are happy to carry, then add both Toronto land transfer taxes, legal fees and a cushion for the first repairs. Only then do we look at listings.',
  },
  {
    title: 'Choose two or three neighbourhoods',
    body: 'Toronto has hundreds of neighbourhoods and the subway line you live near shapes the whole week. We compare the ones that fit your commute and your budget, using TRREB figures for the property type you want.',
  },
  {
    title: 'Look until you can judge value',
    body: 'After a handful of viewings in the same area and price range, most buyers can tell a fair price from a stretch. That is the point to stop touring and start deciding.',
  },
  {
    title: 'Look past the listing photos',
    body: 'Knob and tube wiring and old plumbing in pre-war houses, the age of the roof and furnace, a basement that takes water or a condo reserve fund that is running low. We check what we can before you commit and tell you what to have inspected.',
  },
  {
    title: 'Offer to suit the market you are in',
    body: 'A condo with no other offers and a semi with an offer date are negotiated very differently. We tell you which situation you are in, which conditions are realistic and where our advice is to walk away.',
  },
  {
    title: 'Close without last minute surprises',
    body: 'We stay in touch with your lawyer and lender, keep track of every condition and arrange a final visit so you can confirm the home is as agreed before closing.',
  },
];

const faq = [
  {
    q: 'How is a buyer agent paid in Ontario?',
    a: 'It is set out in writing in a buyer representation agreement, including how much and who pays it. We go through that agreement with you clause by clause before you sign.',
  },
  {
    q: 'Do Toronto buyers really pay two land transfer taxes?',
    a: 'Yes. A purchase in the City of Toronto carries Ontario land transfer tax and the City\'s municipal land transfer tax, both paid on closing. Eligible first-time buyers can recover up to $4,000 and up to $4,475 respectively.',
  },
  {
    q: 'Should I skip the home inspection to compete?',
    a: 'That depends on the specific property and we will say plainly what the risk is. With older Toronto houses the risk is often real. A pre-offer inspection is one way to keep some protection.',
  },
  {
    q: 'What should I budget for besides the price?',
    a: 'Both land transfer taxes, legal fees, title insurance, adjustments, moving costs and early repairs or furniture. We put these in writing at the start so the budget is complete.',
  },
  {
    q: 'I am buying a condo. What should I check?',
    a: 'The status certificate, which includes the budget and reserve fund. Also check the monthly fee and what it covers. Your lawyer reviews the certificate before the condition period ends.',
  },
  {
    q: 'Can you help if I end up looking outside Toronto?',
    a: 'In Markham, Richmond Hill and the rest of the GTA, yes. Further afield, we would rather refer you to someone who knows that market than guess.',
  },
];
---

<Page
  title="Buying a Home in Toronto: How We Work"
  description="How we help Toronto buyers: a budget with both land transfer taxes, a short neighbourhood list, checks on older homes and offers that fit the market."
  eyebrow="For buyers"
  h1="Buying a Toronto home with the numbers in front of you"
  accent="numbers"
  lede="Where you buy decides your commute, your costs and your resale for years. We spend most of our effort on that choice and the rest on making sure the home itself holds no surprises."
  crumbs={crumbs}
  faq={faq}
>
  <Fragment slot="hero-actions">
    <div class="page-hero__actions">
      <a class="btn btn--primary" href="/contact/">Start a conversation</a>
      <a class="btn btn--ghost" href={site.contact.phoneHref}>Call {site.contact.phone}</a>
    </div>
  </Fragment>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The process</p>
        <h2>How a purchase runs, step by step</h2>
        <p class="lede">
          Buyers get into trouble when they skip ahead: touring homes before the budget includes the
          taxes or writing an offer before knowing whether anyone else is bidding.
        </p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step">
              <span class="step__num">Step {String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--dark on-dark">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What you can expect</p>
        <h2>What we promise every buyer</h2>
      </div>
      <div class="promises">
        <div class="promise">
          <h3>Say so when a home is wrong for you</h3>
          <p>
            Even if it means no deal that week. Talking someone into the wrong home is the fastest
            way to lose a client for good.
          </p>
        </div>
        <div class="promise">
          <h3>Be clear about what we know</h3>
          <p>
            Our guides cover twelve Toronto neighbourhoods with sourced figures. Outside the markets
            we work in, we refer you rather than guess.
          </p>
        </div>
        <div class="promise">
          <h3>Write the numbers down</h3>
          <p>
            Your budget, your closing costs and the comparable sales behind any offer price, on paper,
            so nothing important depends on memory.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Start here</p>
        <h2>Which neighbourhood?</h2>
        <p class="lede">
          Twelve guides with TRREB prices by property type, housing stock, subway stations and
          parks. Reading the two or three you are drawn to before we talk makes the first meeting
          far more useful.
        </p>
      </div>
      <NeighbourhoodGrid />
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap-narrow">
      <FaqAccordion faq={faq} heading="Buyer questions" accent="questions" />
      <div class="disclaimer">
        <p>
          <strong>Not advice.</strong> This page is general information about how we work with
          buyers. It is not legal, tax, mortgage or investment advice. Speak to a lawyer, an
          accountant and a mortgage professional about your own circumstances.
        </p>
        <p>
          <strong>Representation.</strong> Ask us to explain the written representation agreement
          and how compensation works before you sign anything.
        </p>
      </div>
    </div>
  </section>

  <Cta />
</Page>

<style>
  .promises {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--sp-6);
  }
  .promise {
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule-dark);
  }
  .promise h3 {
    font-size: var(--step-1);
    color: var(--text-on-dark);
    margin-bottom: var(--sp-3);
  }
  .promise p {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-on-dark-muted);
  }
</style>
