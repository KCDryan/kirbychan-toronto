---
import Page from '../../layouts/Page.astro';
import HomeChoices from '../../components/HomeChoices.astro';
import IdxDisclaimer from '../../components/IdxDisclaimer.astro';
import site from '../../data/site.json';
import { AREAS } from '../../lib/proptx';
import { TYPE_PAGES } from '../../lib/landing';
import '../../styles/home-search.css';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Homes for Sale', path: '/homes-for-sale/' },
  { name: 'Map', path: '/homes-for-sale/map/' },
];
---

<Page
  title="Toronto Homes for Sale Map | Live MLS® Listings"
  description="Toronto homes for sale on a map, live from TRREB's MLS® System. Pick condos, townhouses, bungalows or houses and a neighbourhood, then tap a price to open it."
  eyebrow="Toronto, Ontario"
  h1="Toronto homes for sale on a map"
  lede="The map opens on Toronto and covers the whole GTA. Pick the kind of home you want and each one appears where it stands, labelled with its asking price. Tap a price to open that home."
  crumbs={crumbs}
  compact
>
  <section class="section hs-section">
    <div class="wrap hs">
      <div class="hs-layout">
        <div class="hs-layout__filters">
          <HomeChoices showCounts={false}>
            <details class="hs__more">
              <summary>More choices: homes for rent</summary>
              <h3>Buy or rent</h3>
              <div class="hs-seg hs-seg--2">
                <a class="hs__choice hs-seg__item" data-key="for" data-value="" href="?">To buy</a>
                <a class="hs__choice hs-seg__item" data-key="for" data-value="lease" href="?for=lease">To rent</a>
              </div>
            </details>
          </HomeChoices>
        </div>

        <div class="hs-layout__results">
          <div class="hs__summary" id="results-top">
            <p id="status" aria-live="polite">Loading the map…</p>
            <div class="hs-active" id="active" hidden></div>
            <div class="hs__summary-row">
              <a class="btn btn--ghost" id="as-list" href="/homes-for-sale/">Show as a list</a>
              <a class="btn btn--ghost" id="reset" href="/homes-for-sale/map/" hidden>Start over</a>
            </div>
          </div>
          <div class="hs-map" id="map" role="region" aria-label="Map of Toronto homes for sale. Each label is an asking price."></div>
          <p class="hs-map__help">Tap a price to open that home. The + and − buttons zoom in and out. A numbered circle stands for that many homes close together: tap it to zoom in.</p>
          <div class="hs-picked" id="picked" aria-live="polite" hidden></div>
        </div>
      </div>

      <a class="btn btn--primary hs__jump" id="jump" href="#results-top">See the map ↓</a>

      <div class="prose hs__intro">
        <h2>How the map works</h2>
        <p>
          Each price on the map is a home listed for sale today in Toronto or elsewhere in the GTA,
          placed at its street address. Drag the map or zoom out to see Mississauga, Vaughan, Markham,
          Pickering and the rest of the region.
          The buttons on the left narrow it by kind of home, neighbourhood, price and bedrooms. The map
          redraws as soon as you press one. Where many homes sit close together they share a
          numbered circle. Tap the circle to zoom in on them.
        </p>
        <p>
          Some listings have no pin. A seller can ask that the address stay off the internet. An address
          that cannot be matched to the exact building is left off rather than guessed. Every
          listing is still in the <a href="/homes-for-sale/">list search</a>. For prices homes actually
          sold for nearby, open a free <a href="/sold/">Toronto sold prices</a> account. You can also call
          {site.contact.phone} and we will run the search with you.
        </p>
        <h2>Browse Toronto homes for sale</h2>
        <p><strong>By home type:</strong> {Object.entries(TYPE_PAGES).map(([s, t], i) => <>{i > 0 && ' · '}<a href={`/homes-for-sale/${s}/`}>{t.label}</a></>)}</p>
        <p><strong>By neighbourhood:</strong> {Object.entries(AREAS).map(([s, a], i) => <>{i > 0 && ' · '}<a href={`/homes-for-sale/${s}/`}>{a.label}</a></>)}</p>
      </div>

      <IdxDisclaimer />
    </div>
  </section>
</Page>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import 'leaflet.markercluster/dist/MarkerCluster.css';
  import site from '../../data/site.json';
  import { AREAS, HOMES, PRICES } from '../../lib/proptx';
  import { $, activeChips, bindChoices, current, describe, el, factsRow, homeType, media, money, syncChoices, syncCounts, watchJump } from '../../scripts/home-search';

  type Pin = { k: string; la: number; ln: number; p: number; b: number | null; ba: number | null; t: string | null; s: string | null; a: string };

  const KEYS = ['home', 'area', 'price', 'beds', 'city', 'for'];
  const LABEL = (key: string, value: string) =>
    ({ home: HOMES[value]?.label, area: AREAS[value]?.label, price: PRICES[value]?.label, beds: `${value}+ bedrooms`, city: value, for: 'For rent' })[key] ?? value;
  /** "$899K", "$1.25M": short enough to read on a map. */
  const short = (n: number, lease: boolean) =>
    lease ? `$${Math.round(n).toLocaleString('en-CA')}` : n >= 1e6 ? `$${(n / 1e6).toFixed(n >= 1e7 ? 1 : 2).replace(/\.?0+$/, '')}M` : `$${Math.round(n / 1000)}K`;

  // leaflet.markercluster attaches itself to the global L, so it loads after L is set.
  (window as unknown as { L: typeof L }).L = L;
  import('leaflet.markercluster').then(start);

  function start() {
  const map = L.map('map', { scrollWheelZoom: false, zoomControl: false }).setView([43.7, -79.39], 11);
  L.control.zoom({ position: 'topright', zoomInTitle: 'Zoom in', zoomOutTitle: 'Zoom out' }).addTo(map);
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
  }).addTo(map);
  // Scrolling the page never zooms the map by accident; a click or tap on the map turns wheel zoom on.
  map.on('click', () => map.scrollWheelZoom.enable());
  map.on('mouseout', () => map.scrollWheelZoom.disable());

  // Clusters keep the drawn markers to a few hundred at most, even with every Toronto listing loaded.
  const group = L.markerClusterGroup({
    chunkedLoading: true,
    showCoverageOnHover: false,
    maxClusterRadius: 50,
    iconCreateFunction: (c) => L.divIcon({ className: 'hs-cluster', html: `<span>${c.getChildCount()}</span>`, iconSize: L.point(52, 52) }),
  });
  map.addLayer(group);

  let picked: L.Marker | null = null;
  const pick = (pin: Pin, marker: L.Marker, lease: boolean) => {
    picked?.getElement()?.classList.remove('is-picked');
    marker.getElement()?.classList.add('is-picked');
    picked = marker;
    const box = $('picked');
    const card = el('div', 'hs__card hs-picked__card');
    const body = el('div', 'hs__body');
    const see = el('a', 'btn btn--primary hs__see', 'See photos and details') as HTMLAnchorElement;
    see.href = '/homes-for-sale/listing/?id=' + encodeURIComponent(pin.k);
    const ask = el('a', 'btn btn--ghost hs__see', 'Ask about this home') as HTMLAnchorElement;
    ask.href = '/contact/?listing=' + encodeURIComponent(pin.k);
    body.append(
      el('p', 'hs__price', money(pin.p) + (lease ? ' a month' : '')),
      el('p', 'hs__addr', pin.a),
      factsRow({ beds: pin.b, baths: pin.ba }),
      see,
      ask,
      el('p', 'hs__brokerage', `MLS® ${pin.k}. The listing brokerage is shown on the details page.`),
    );
    const mediaBox = media(null, pin.a, homeType({ style: pin.s, type: pin.t }));
    card.append(mediaBox, body);
    box.replaceChildren(el('h2', 'hs-picked__title', 'The home you chose'), card);
    box.hidden = false;
    if (innerWidth < 1080) box.scrollIntoView({ block: 'nearest' });
    // The photo and brokerage come from the listing itself.
    fetch('/api/listings?id=' + encodeURIComponent(pin.k))
      .then((r) => (r.ok ? r.json() : null))
      .then((l) => {
        if (!l || picked !== marker) return;
        mediaBox.replaceWith(media(l.photos?.[0] ?? null, pin.a, homeType({ style: pin.s, type: pin.t })));
        body.querySelector('.hs__brokerage')!.textContent = `Listed by ${l.brokerage || 'the listing brokerage'}. MLS® ${pin.k}`;
      })
      .catch(() => {});
  };

  /** With no neighbourhood or city chosen the map covers the GTA, so say so. */
  const where = (p: URLSearchParams, verb: string, one = false) =>
    p.get('area') || p.get('city') ? describe(p, verb, one) : describe(p, verb, one).replace(' in Toronto', ' in the GTA');

  let seq = 0;
  const load = () => {
    const p = current(KEYS);
    const lease = p.get('for') === 'lease';
    const verb = lease ? 'for rent' : 'for sale';
    syncChoices(p);
    syncCounts(p);
    activeChips(p, $('active'), LABEL);
    ($('as-list') as HTMLAnchorElement).href = '/homes-for-sale/' + (p.toString() ? '?' + p : '');
    $('reset').hidden = ![...p.keys()].length;
    if (p.get('for')) (document.querySelector('.hs__more') as HTMLDetailsElement).open = true;
    $('status').textContent = 'Finding ' + where(p, verb) + '…';
    $('picked').hidden = true;
    picked = null;
    const mine = ++seq;
    fetch('/api/map?' + p)
      .then((r) => r.json().then((body) => ({ ok: r.ok, body })))
      .then(({ ok, body }) => {
        if (mine !== seq) return;
        if (!ok) throw body;
        const pins = body.pins as Pin[];
        group.clearLayers();
        const markers = pins.map((pin) => {
          const m = L.marker([pin.la, pin.ln], {
            icon: L.divIcon({ className: 'hs-pin', html: `<span>${short(pin.p, lease)}</span>`, iconSize: undefined }),
            title: `${money(pin.p)}, ${pin.a}`,
            alt: `${money(pin.p)}, ${pin.a}`,
            riseOnHover: true,
          });
          m.on('click', () => pick(pin, m, lease));
          m.on('keypress', (e) => (e.originalEvent as KeyboardEvent).key === 'Enter' && pick(pin, m, lease));
          return m;
        });
        group.addLayers(markers);
        // A chosen neighbourhood fills the map; otherwise the view stays where it is (Toronto at first).
        if (markers.length && (p.get('area') || p.get('city'))) map.fitBounds(L.latLngBounds(pins.map((x) => [x.la, x.ln] as [number, number])), { padding: [40, 40], maxZoom: 15 });
        const off = body.hidden as number;
        $('status').textContent = pins.length
          ? `${pins.length.toLocaleString('en-CA')} ${where(p, verb, pins.length === 1)} on the map.` + (off ? ` ${off.toLocaleString('en-CA')} more ${off === 1 ? 'is' : 'are'} not on the map yet.` : '')
          : body.total
            ? `The ${(body.total as number).toLocaleString('en-CA')} ${where(p, verb, body.total === 1)} ${body.total === 1 ? 'is' : 'are'} still being placed on the map. They appear here a few thousand a day, Toronto first.`
            : `There are no ${where(p, verb)} on the map right now. Try "Any price" or "All of Toronto".`;
        $('jump').textContent = pins.length ? `See the ${pins.length.toLocaleString('en-CA')} homes on the map ↓` : 'See the map ↓';
      })
      .catch((err: { error?: string }) => {
        if (mine !== seq) return;
        $('status').textContent =
          err?.error === 'map-not-configured'
            ? `The map is being set up. Please use the list search for now or call us at ${site.contact.phone}.`
            : `The map could not be loaded just now. Please try again in a minute, use the list search or call us at ${site.contact.phone}.`;
      });
  };

  bindChoices(load);
  watchJump();
  }
</script>
