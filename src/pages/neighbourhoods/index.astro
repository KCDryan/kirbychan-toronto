---
import Page from '../../layouts/Page.astro';
import NeighbourhoodGrid from '../../components/NeighbourhoodGrid.astro';
import Cta from '../../components/Cta.astro';
import market from '../../data/market.json';
import { cad } from '../../lib/format';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Neighbourhoods', path: '/neighbourhoods/' },
];

const priced = market.neighbourhoods.filter((n): n is typeof n & { price: number } => typeof n.price === 'number');
const top = [...priced].sort((a, b) => b.price - a.price)[0];
const low = [...priced].sort((a, b) => a.price - b.price)[0];

const faq = [
  {
    q: 'How were these twelve Toronto neighbourhoods chosen?',
    a: 'Each one matches one or two communities that TRREB reports on every quarter, so every guide can quote real sales figures. Together they cover detached house areas, condo areas near the subway and the neighbourhoods downsizers ask us about most.',
  },
  {
    q: 'Which of these neighbourhoods had the highest prices?',
    a: `Across all property types, ${top.name} had the highest median of the TRREB communities in our guides for ${market.period}, at ${cad(top.price)}. For one property type, compare the tables in each guide, because the mix of houses and condos moves the overall figure.`,
  },
  {
    q: 'Where is the lowest entry price?',
    a: `Condo apartments. ${low.name} had the lowest all types median of the communities covered, ${cad(low.price)} for ${market.period}, because nearly all of its sales were condos. Each guide lists the condo apartment median separately.`,
  },
  {
    q: 'Which neighbourhoods are on the subway?',
    a: 'All but The Beaches have a Line 1, Line 2, Line 4 or Line 5 station in or beside them. The Beaches is served by streetcars and buses to Main Street and Woodbine stations on Line 2.',
  },
  {
    q: 'How do I narrow it down?',
    a: 'Start with how you will spend the week: where you travel to, whether you want a house or a condo and your budget for that type. Those three usually bring twelve options down to two or three.',
  },
];
---

<Page
  title="Toronto Neighbourhoods: Where to Live in Toronto"
  description="Twelve Toronto neighbourhood guides with TRREB prices by property type, housing stock, subway and LRT stations, parks and libraries, trade-offs stated plainly."
  eyebrow="Toronto, Ontario"
  h1="Toronto neighbourhoods, one guide each"
  accent="one guide each"
  lede="Toronto is a city of very different housing markets. A few subway stops can separate streets of detached houses from blocks of condo towers. Each guide below sets out the prices, homes and transit for one neighbourhood."
  crumbs={crumbs}
  faq={faq}
>
  <section class="section">
    <div class="wrap">
      <NeighbourhoodGrid level={2} />
      <nav class="hub-links" aria-label="Compare Toronto neighbourhoods">
        <h2>Compare them by what you need</h2>
        <ul>
          <li><a href="/best-toronto-neighbourhoods-for-downsizing/">Best Toronto neighbourhoods to downsize</a></li>
          <li><a href="/best-toronto-neighbourhoods-for-families/">Neighbourhoods with the most houses</a></li>
          <li><a href="/best-toronto-neighbourhoods-for-commuters/">Neighbourhoods by subway commute</a></li>
          <li><a href="/toronto-house-prices/">Toronto house prices by community</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <h2>Where to start in Toronto</h2>
        <p class="lede">
          Three questions shorten the list quickly: where you need to get to, whether you want a house
          or a condo and what that type costs in each area.
        </p>
      </div>
      <div class="starters">
        <div class="starter">
          <h3>A condo near the subway</h3>
          <p>
            Yonge and Eglinton, Willowdale and Bayview Village had the most condo apartment sales in our
            guides from April to June 2026, near Line 1, Line 4 and Line 5 stations.
          </p>
        </div>
        <div class="starter">
          <h3>A detached house</h3>
          <p>
            Lawrence Park, Leaside and The Beaches sold mostly detached houses. Islington Village and
            Willowdale West had the lower detached medians among our guides.
          </p>
        </div>
        <div class="starter">
          <h3>A short ride downtown</h3>
          <p>
            The downtown waterfront has Union station at its edge. The Annex is 7 stops away on Line 1
            and Riverdale 9 stops via Line 2 and Line 1.
          </p>
        </div>
        <div class="starter">
          <h3>A semi-detached house</h3>
          <p>
            Semi-detached houses led sales in North and South Riverdale. The Annex, The Beaches and
            High Park North each recorded 11 or more semi-detached sales from April to June 2026.
          </p>
        </div>
      </div>
      <p class="map-link">
        <a href="/map-of-toronto/">See where each neighbourhood sits on the map</a>
      </p>
    </div>
  </section>

  <Cta />
</Page>

<style>
  .starters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--sp-5);
  }
  .starter {
    padding-top: var(--sp-4);
    border-top: 2px solid var(--brass);
  }
  .starter h3 {
    font-size: var(--step-1);
    margin-bottom: var(--sp-3);
  }
  .starter p {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .map-link {
    margin-top: var(--sp-7);
    font-size: 0.9rem;
  }
</style>
