---
import Page from '../layouts/Page.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import DownsizingPromo from '../components/DownsizingPromo.astro';
import Cta from '../components/Cta.astro';
import site from '../data/site.json';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Sellers', path: '/sellers/' },
];

const steps = [
  {
    title: 'Start from the sales around you',
    body: 'We set the price from recent sales of similar homes nearby, the listings you will compete with and what is particular to your property. You see the comparables. If your number and ours differ, we say so before you sign anything.',
  },
  {
    title: 'Spend only where it pays',
    body: 'Some work earns back more than it costs. Much of it does not, especially in older Toronto houses a buyer plans to renovate. We walk through the home with you and sort the two.',
  },
  {
    title: 'Show the home at its best',
    body: 'Photographs, video, floor plans and staging chosen for the home and the likely buyer. When several similar semis or condos are listed on the same street, presentation is often what separates them.',
  },
  {
    title: 'Put it where buyers search',
    body: 'The MLS listing does most of the work. The rest of the marketing exists to bring the right people to it. We tell you which parts help your sale and which only help an agent look busy.',
  },
  {
    title: 'Keep you informed weekly',
    body: 'A written update each week: showings, buyer comments, what nearby homes sold for and our recommendation. Hearing nothing during a quiet listing is the complaint we hear most from sellers who switch to us.',
  },
  {
    title: 'Weigh every offer, then close',
    body: 'Price is only one term. We explain the deposit, conditions and closing date on each offer and what each is worth to you, then stay with the file through to closing.',
  },
];

const faq = [
  {
    q: 'How is the list price set?',
    a: 'From recent comparable sales, the homes currently competing with yours and the features of your property. We show you that evidence so you can judge the number yourself.',
  },
  {
    q: 'Another agent suggested a higher price. Who is right?',
    a: 'Ask each agent for the comparable sales behind the figure. A number without evidence is a guess. A price set above the market often leads to a reduction a few weeks later.',
  },
  {
    q: 'Should I renovate my Toronto house before listing?',
    a: 'Usually no more than paint, repairs and a thorough clear out. Kitchens and bathrooms rarely return their cost, particularly when buyers expect to renovate an older house anyway.',
  },
  {
    q: 'How long does a Toronto home take to sell?',
    a: 'It varies by price, type and condition. In August 2026, homes that sold in the City of Toronto had been listed for an average of 35 days (TRREB Market Watch). We give you a range for your own home at the listing appointment.',
  },
  {
    q: 'What does it cost to sell?',
    a: 'The commission set out in the listing agreement, legal fees, any preparation you choose, moving costs and a mortgage discharge fee if you have a mortgage. We give you a written estimate before you list.',
  },
  {
    q: 'I am selling a parent\'s home or an estate property. Is that different?',
    a: 'Yes. An estate trustee usually needs authority before closing and a vacant Toronto home can bring Vacant Home Tax questions. Our estate home guide covers the steps. We work alongside the estate lawyer.',
  },
];
---

<Page
  title="Selling a House in Toronto: How We Sell Homes"
  description="How we sell Toronto homes: a price built from nearby sales, preparation that pays for itself, marketing aimed at real buyers and a written report every week."
  eyebrow="For sellers"
  h1="Selling your Toronto home at a price you can defend"
  accent="defend"
  lede="Listing high to see what happens is the costliest habit in real estate. Buyers compare every home with the sales around it, so we start there too."
  crumbs={crumbs}
  faq={faq}
>
  <Fragment slot="hero-actions">
    <div class="page-hero__actions">
      <a class="btn btn--primary" href="/contact/">Request a valuation</a>
      <a class="btn btn--ghost" href={site.contact.phoneHref}>Call {site.contact.phone}</a>
    </div>
  </Fragment>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The process</p>
        <h2>How we run a sale, from price to closing</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step">
              <span class="step__num">Step {String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--dark on-dark">
    <div class="wrap-narrow">
      <div class="section-head">
        <p class="eyebrow">Why the first price matters</p>
        <h2>The cost of a listing that sits</h2>
      </div>
      <p class="dark-p">
        TRREB reported that homes sold in the City of Toronto in August 2026 had been listed for an
        average of 35 days. A listing that stays well past that begins to stand out on buyers'
        screens for the wrong reason.
      </p>
      <p class="dark-p">
        Buyers watching a price that is too high rarely go away. They wait for the reduction and
        then use the time on market to argue for more. The early interest that a well priced home
        attracts is hard to win back later.
      </p>
      <p class="dark-p">
        So we would rather turn down a listing than accept a price we cannot support with sales.
        A defensible first price is the plan, not a lack of ambition.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Selling in a particular situation?</p>
        <h2>Some sales need more than a listing</h2>
      </div>
      <ServiceGrid only={['estate-sales', 'downsizing', 'luxury', 'upsizing']} />
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap-narrow">
      <div class="sellers-dpromo"><DownsizingPromo /></div>
      <FaqAccordion faq={faq} heading="Seller questions" accent="questions" />
      <div class="disclaimer">
        <p>
          <strong>Not advice.</strong> This page is general information about how we work with
          sellers. It is not legal, tax or financial advice. Speak to a lawyer and an accountant
          about your own circumstances.
        </p>
        <p>
          <strong>Agreements.</strong> Commission, the term and the services included are set out
          in the written listing agreement. Ask us to go through it line by line before you sign.
        </p>
      </div>
    </div>
  </section>

  <Cta
    heading="Book a 30-minute valuation conversation"
    accent="30-minute"
    body="We bring the comparable sales for your street and tell you what we think your home would sell for, whether or not you list with us."
  />
</Page>

<style>
  .sellers-dpromo {
    margin-bottom: var(--sp-7);
  }
  .dark-p {
    color: var(--text-on-dark-muted);
    line-height: 1.75;
    max-width: 62ch;
  }
  .dark-p + .dark-p {
    margin-top: var(--sp-4);
  }
</style>
