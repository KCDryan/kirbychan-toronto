---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import Cta from '../components/Cta.astro';
import { neighbourhoodPath } from '../lib/format';
import map from '../data/toronto-map.json';

const hoods = (await getCollection('neighbourhoods', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const byId = new Map(hoods.map((h) => [h.id, h]));

// Shapes are the City of Toronto's official neighbourhood boundaries, drawn to scale by
// scripts/build-toronto-map.mjs. Labels sit on each area's centre; the dense midtown labels are
// moved clear of each other and joined to their area by a short line.
const NUDGE: Record<string, [number, number]> = {
  'lawrence-park': [-150, -10],
  'yonge-eglinton': [-190, 20],
  'the-annex': [-150, 40],
  leaside: [120, -20],
  'don-mills': [120, -30],
  'downtown-waterfront': [0, 70],
  riverdale: [90, 40],
  'bayview-village': [110, -40],
  willowdale: [-130, -40],
  'mount-pleasant-east': [190, -70],
  rosedale: [10, 75],
  danforth: [170, 0],
};
const pins = map.guides
  .filter((g) => byId.has(g.slug))
  .map((g) => {
    const [dx, dy] = NUDGE[g.slug] ?? [0, 0];
    const label = byId.get(g.slug)!.data.name;
    return { ...g, label, lx: g.x + dx, ly: g.y + dy, width: Math.max(96, label.length * 8.6 + 28) };
  });

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Map of Toronto', path: '/map-of-toronto/' },
];

const west = [...pins].sort((a, b) => a.x - b.x);
const north = [...pins].sort((a, b) => a.y - b.y);
const faq = [
  {
    q: 'Where do the shapes on this map come from?',
    a: 'From the City of Toronto\'s own neighbourhood boundaries, published on its Open Data portal. Each guide is drawn as the City neighbourhood or neighbourhoods it covers. TRREB, which publishes the price figures in our guides, uses its own community boundaries, which are close to these but not identical.',
  },
  {
    q: 'Which of the eighteen are furthest north and furthest west?',
    a: `On the City's boundaries, ${north[0].label} and ${north[1].label} are the two furthest north of the eighteen and ${west[0].label} is the furthest west. ${west[west.length - 1].label} is the furthest east.`,
  },
  {
    q: 'Can I use this map to check an address?',
    a: 'Not on its own. It shows each neighbourhood at city scale. For a specific address, check the City of Toronto\'s neighbourhood profiles or ask us. Confirm school boundaries with the school board.',
  },
];
---

<Page
  title="Map of Toronto Neighbourhoods We Cover"
  description="A to scale map of the eighteen Toronto neighbourhoods in our guides, drawn from the City of Toronto's official neighbourhood boundaries, linked to each guide."
  eyebrow="Orientation"
  h1="Where the eighteen neighbourhoods are"
  accent="eighteen"
  lede="Our eighteen Toronto neighbourhood guides on one map, drawn to scale from the City's official neighbourhood boundaries. Select any name to open its guide."
  crumbs={crumbs}
  faq={faq}
>
  <section class="section">
    <div class="wrap">
      <div class="map-scroll">
        <svg
          class="map"
          viewBox={`0 0 ${map.width} ${map.height}`}
          role="group"
          aria-labelledby="map-title map-desc"
          xmlns="http://www.w3.org/2000/svg"
        >
          <title id="map-title">Map of the City of Toronto with eighteen neighbourhoods highlighted</title>
          <desc id="map-desc">
            The City of Toronto divided into its 158 official neighbourhoods, with the areas covered by
            our eighteen guides shaded and labelled. North is at the top. A text list of the same
            neighbourhoods follows below the map.
          </desc>

          <path d={map.others} class="area" />
          {pins.map((p) => <path d={p.d} class="area area--guide" />)}
          {
            pins.map((p) => (
              <a href={neighbourhoodPath(p.slug)} class="pin">
                {(p.lx !== p.x || p.ly !== p.y) && <line x1={p.x} y1={p.y} x2={p.lx} y2={p.ly} class="pin__lead" />}
                <rect x={p.lx - p.width / 2} y={p.ly - 15} width={p.width} height="30" rx="3" class="pin__box" />
                <text x={p.lx} y={p.ly + 5} text-anchor="middle" class="pin__text">{p.label}</text>
              </a>
            ))
          }

          <text x={map.width - 22} y="34" text-anchor="end" class="compass">N &uarr;</text>
        </svg>
      </div>
      <p class="map-note">
        Boundaries: {map.source}. Contains information licensed under the
        <a href="https://open.toronto.ca/open-data-license/" rel="noopener noreferrer" target="_blank">Open Government Licence, Toronto</a>.
        TRREB community boundaries, used for the prices in each guide, differ slightly from the City's.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">In words</p>
        <h2>The same eighteen, listed</h2>
      </div>
      <ul class="text-map" role="list">
        {
          hoods.map((h) => (
            <li>
              <a href={neighbourhoodPath(h.id)}>{h.data.name}</a>
              <span>{h.data.personality}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Cta />
</Page>

<style>
  .map-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--mist);
  }
  .map {
    display: block;
    min-width: 720px;
    width: 100%;
    height: auto;
  }
  .map :global(.area) {
    fill: #ffffff;
    stroke: var(--rule);
    stroke-width: 0.8;
  }
  .map :global(.area--guide) {
    fill: var(--brand);
    fill-opacity: 0.22;
    stroke: var(--brand);
    stroke-width: 1.2;
  }
  .map :global(.pin__lead) {
    stroke: var(--brand);
    stroke-width: 1.2;
  }
  .map :global(.compass) {
    font-family: var(--font-heading);
    font-size: 18px;
    fill: var(--brand);
  }
  .map :global(.pin__box) {
    fill: #ffffff;
    stroke: var(--rule);
    stroke-width: 1;
    transition:
      fill 0.15s ease,
      stroke 0.15s ease;
  }
  .map :global(.pin__text) {
    font-family: var(--font-heading);
    font-size: 14px;
    fill: var(--ink);
  }
  .map :global(.pin:hover .pin__box),
  .map :global(.pin:focus-visible .pin__box) {
    fill: var(--brass);
    stroke: var(--brand);
  }
  .map :global(.pin:hover .pin__text),
  .map :global(.pin:focus-visible .pin__text) {
    fill: var(--ground);
  }
  .map :global(.pin) {
    cursor: pointer;
  }

  .map-note {
    margin-top: var(--sp-4);
    font-size: 0.78rem;
    color: var(--text-muted);
    max-width: 72ch;
  }

  .text-map {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--sp-4) var(--sp-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .text-map li {
    display: grid;
    gap: 0.2rem;
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
  }
  .text-map a {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    text-decoration: none;
  }
  .text-map span {
    font-size: 0.82rem;
    color: var(--text-muted);
  }
</style>
