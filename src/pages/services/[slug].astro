---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ServiceBody from '../../components/ServiceBody.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { publishedPosts } from '../../lib/blog-posts';
import { breadcrumbList, faqPage, service } from '../../lib/schema';
import { hasGuide } from '../../lib/guides';
import { getImage } from 'astro:assets';
import { neighbourhoodPhoto, photoAlt } from '../../lib/photos';
import credits from '../../data/photo-credits.json';

export const getStaticPaths = (async () => {
  // Services with a pillar guide are served by the guide instead (301 in _redirects).
  const services = await getCollection('services', (s) => !s.data.draft && !hasGuide(s.id));
  return services.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props as Props;
const d = entry.data;
const { Content } = await render(entry);
const path = `/services/${entry.id}/`;

// Everything on the site that names this service, so the page links down to its
// own cluster instead of only sideways to the other services.
const everyPost = await publishedPosts();
// Posts a page written at /uploadservice/ chose, then any post that names this service.
const chosen = d.relatedPosts.map((url) => everyPost.find((p) => `/blog/${p.id.split('/').pop()}/` === url)).filter((p): p is (typeof everyPost)[number] => Boolean(p));
const posts = [...chosen, ...everyPost.filter((p) => p.data.relatedServices.includes(entry.id) && !chosen.includes(p))].slice(0, 6);
const hoods = await getCollection(
  'neighbourhoods',
  (h) => !h.data.draft && h.data.relatedServices.includes(entry.id)
);


// The proof block: the neighbourhood guide a generated page names, with its photo.
const hoodId = d.proofHood?.match(/^\/([a-z0-9-]+)-toronto\/$/)?.[1];
const proofHood = hoodId ? (await getCollection('neighbourhoods')).find((h) => h.id === hoodId) : undefined;
const proofPhoto = hoodId ? neighbourhoodPhoto(hoodId) : undefined;
const proof =
  proofHood && d.proof && d.proofHood
    ? {
        name: proofHood.data.name,
        text: d.proof,
        url: d.proofHood,
        src: proofPhoto ? (await getImage({ src: proofPhoto, width: 880, height: 540, format: 'webp', fit: 'cover' })).src : '',
        alt: (hoodId && photoAlt(hoodId)) || `${proofHood.data.name}, Toronto`,
        credit: proofPhoto ? (() => { const c = credits.find((x) => x.slug === hoodId); return c?.source && c.licenseUrl ? { author: c.author, source: c.source, license: c.license, licenseUrl: c.licenseUrl } : undefined; })() : undefined,
      }
    : undefined;
const shareImage = proofPhoto ? (await getImage({ src: proofPhoto, width: 1200, height: 630, format: 'jpg', fit: 'cover' })).src : undefined;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: d.name, path },
];

const jsonLd = [
  breadcrumbList(crumbs),
  service({ name: d.name, description: d.description, path }),
  faqPage(d.faq),
].filter(Boolean);
---

<Base title={d.title} description={d.description} noindex={d.noindex} jsonLd={jsonLd} ogImage={shareImage}>
  <Breadcrumbs crumbs={crumbs} />
  <ServiceBody id={entry.id} d={d} uploadVersion={d.uploadVersion} posts={posts} hoods={hoods} proof={proof}>
    <Content />
  </ServiceBody>
</Base>
