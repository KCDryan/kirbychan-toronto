---
import Page from '../../layouts/Page.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import Cta from '../../components/Cta.astro';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
];
---

<Page
  title="How We Work | Kirby Chan & Co. Toronto"
  description="How we help in Toronto: buying, selling, luxury, relocation, downsizing, first-time buyers, new construction, estate sales and separation, each explained."
  eyebrow="How we help"
  h1="Most people arrive with a situation, not a search"
  accent="situation"
  lede="A job that starts in eight weeks. A parent's house that has to be sold. A condo that has become too small. The work is different in each case, so these pages are written one situation at a time."
  crumbs={crumbs}
>
  <section class="section">
    <div class="wrap">
      <ServiceGrid level={2} />
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap-narrow prose">
      <h2>The data and tools behind each service</h2>
      <p>
        Every service on this page rests on the same evidence. <a href="/toronto-house-prices/">Toronto house
        prices</a> give TRREB's latest figures by property type. <a href="/sold/">Toronto sold prices</a> show
        what individual homes sold for. You can browse <a href="/homes-for-sale/">Toronto homes for sale</a>
        as a list or <a href="/homes-for-sale/map/">on a map</a>.
      </p>
      <p>
        To put numbers on a move, try the <a href="/land-transfer-tax-calculator-toronto/">land transfer tax
        calculator</a> and the <a href="/mortgage-calculator-toronto/">mortgage calculator</a>. When a parent's
        home has to be sold, our guide to <a href="/blog/selling-a-parents-house-with-power-of-attorney-ontario/">selling
        a parent's house with power of attorney in Ontario</a> sets out who can sign.
      </p>
    </div>
  </section>


  <Cta />
</Page>

