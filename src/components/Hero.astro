---
import site from '../data/site.json';
import Photo from './Photo.astro';
import { langFromPath, localePath, t } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const dict = t(lang);

const searchHref = site.links.loftySearch || '/contact/';
const searchExternal = searchHref.startsWith('http');
---

<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">{dict.home.eyebrow}</p>
      <h1>{dict.home.h1}</h1>
      <p class="lede">{dict.home.lede}</p>
      <div class="hero__actions">
        <a
          class="btn btn--primary"
          href={searchHref}
          rel={searchExternal ? 'noopener' : undefined}
          target={searchExternal ? '_blank' : undefined}
        >
          {dict.ui.nav.searchHomes}{
            searchExternal && <span class="visually-hidden"> ({dict.ui.opensNewTab})</span>
          }
        </a>
        {lang !== 'en' && <a class="btn btn--brass" href={localePath(lang, '/contact/')}>{dict.home.ctaContact}</a>}
        <a class="btn btn--ghost" href={localePath(lang, '/neighbourhoods/')}>{dict.home.ctaNeighbourhoods}</a>
      </div>
    </div>
    <figure class="hero__media">
      <Photo
        name="home-hero-suit"
        alt={dict.home.photoAlt}
        label="Photo of Kirby Chan"
        ratio="4 / 5"
        sizes="(min-width: 900px) 420px, 80vw"
        priority
      />
      <figcaption class="hero__badge">
        <strong>Kirby Chan</strong>
        <span>Broker, {site.brokerage.legalName}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 85% 10%, rgba(30, 55, 101, 0.1), transparent 60%),
      var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .hero__inner {
    display: grid;
    gap: var(--sp-7);
    align-items: center;
    padding-block: clamp(3rem, 1.8rem + 6vw, 6rem);
  }
  .hero .lede {
    margin-top: var(--sp-5);
    max-width: 52ch;
  }
  .hero h1 {
    max-width: 18ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }
  .hero__media {
    position: relative;
    max-width: 360px;
    width: 100%;
    margin: 0 0 var(--sp-5);
    justify-self: center;
  }
  /* A brass frame offset behind the photo. */
  .hero__media::before {
    content: '';
    position: absolute;
    inset: var(--sp-5) calc(-1 * var(--sp-5)) calc(-1 * var(--sp-5)) var(--sp-5);
    border: 2px solid var(--brass);
    border-radius: var(--radius-lg);
    z-index: 0;
  }
  .hero__media :global(.photo) {
    position: relative;
    z-index: 1;
    box-shadow: var(--shadow-lift);
  }
  .hero__badge {
    position: absolute;
    z-index: 2;
    left: calc(-1 * var(--sp-4));
    bottom: var(--sp-6);
    display: grid;
    gap: 0.1rem;
    padding: var(--sp-3) var(--sp-4);
    background: var(--ground);
    color: var(--text-on-dark);
    border-radius: var(--radius);
    border-left: 3px solid var(--brass);
    box-shadow: var(--shadow);
    font-size: 0.8rem;
    line-height: 1.35;
  }
  .hero__badge strong {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .hero__badge span {
    color: var(--text-on-dark-muted);
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.2fr 0.8fr;
      gap: var(--sp-8);
    }
    .hero__media {
      justify-self: end;
      max-width: 420px;
      margin-right: var(--sp-5);
    }
  }
</style>
